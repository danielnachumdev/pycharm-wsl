#!/usr/bin/env bash
# Manage JetBrains PyCharm under WSL: list / install / uninstall / activate.
# Encodes the manual WSL setup: tarball under ~/downloads, shell alias,
# WSLg vmoptions fix, Windows shortcut via wslu.
set -euo pipefail

PRODUCT_CODE="${PYCHARM_PRODUCT_CODE:-PCP}" # PCP = Professional, PCC = Community
INSTALL_ROOT="${PYCHARM_INSTALL_ROOT:-$HOME/downloads}"
STABLE_LINK="${PYCHARM_STABLE_LINK:-$INSTALL_ROOT/pycharm}"
ZSHRC="${PYCHARM_ZSHRC:-$HOME/.zshrc}"
SHORTCUT_NAME="${PYCHARM_SHORTCUT_NAME:-PyCharm WSL}"
VM_OPTION_SHADOW="-Dsun.awt.wl.Shadow=false"
LIST_LIMIT="${PYCHARM_LIST_LIMIT:-30}"

usage() {
  cat <<'EOF'
Usage: pycharm-wsl <command> [args]

Commands:
  list                         Available releases; mark (installed) / (active)
  install VERSION [--no-activate]
                               Download + extract VERSION (from list).
                               Activates it by default (runtime hooks included).
  uninstall VERSION [--keep-archive]
                               Remove an installed extract (and its .tar.gz).
  activate VERSION             Point symlink/alias/shortcut at VERSION and
                               apply WSL runtime fixes (idempotent).

Env:
  PYCHARM_PRODUCT_CODE   PCP (default) or PCC
  PYCHARM_INSTALL_ROOT   default: ~/downloads
  PYCHARM_STABLE_LINK    default: $INSTALL_ROOT/pycharm
  PYCHARM_LIST_LIMIT     max remote versions shown (default: 30)
EOF
}

log() { printf '+ %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

ensure_install_root() {
  mkdir -p "$INSTALL_ROOT"
}

version_dir() {
  printf '%s/pycharm-%s\n' "$INSTALL_ROOT" "$1"
}

version_archive() {
  printf '%s/pycharm-%s.tar.gz\n' "$INSTALL_ROOT" "$1"
}

is_installed() {
  local dir
  dir="$(version_dir "$1")"
  [[ -x "$dir/bin/pycharm.sh" ]]
}

version_from_dir() {
  local dir="$1"
  if [[ -f "$dir/product-info.json" ]]; then
    jq -r '.version // empty' <"$dir/product-info.json"
    return 0
  fi
  local base
  base="$(basename "$dir")"
  printf '%s\n' "${base#pycharm-}"
}

active_dir() {
  if [[ -e "$STABLE_LINK/bin/pycharm.sh" ]]; then
    readlink -f "$STABLE_LINK"
  fi
}

active_version() {
  local dir
  dir="$(active_dir || true)"
  [[ -n "${dir:-}" ]] || return 0
  version_from_dir "$dir"
}

installed_versions() {
  local dir
  while IFS= read -r dir; do
    [[ -x "$dir/bin/pycharm.sh" ]] || continue
    version_from_dir "$dir"
  done < <(find "$INSTALL_ROOT" -maxdepth 1 -type d -name 'pycharm-[0-9]*' 2>/dev/null | sort -V)
}

# JetBrains dataDirectoryName from product-info (e.g. PyCharm2026.3).
data_dir_name() {
  local info
  info="$(version_dir "$1")/product-info.json"
  [[ -f "$info" ]] || return 1
  jq -r '.dataDirectoryName // empty' <"$info"
}

plugins_root() {
  printf '%s/.local/share/JetBrains/%s\n' "$HOME" "$1"
}

plugin_entry_count() {
  local d="$1"
  [[ -d "$d" ]] || { printf '0\n'; return 0; }
  find "$d" -mindepth 1 -maxdepth 1 ! -name '.*' 2>/dev/null | wc -l
}

# Best prior plugins dir: richest other installed version, else any leftover PyCharm* share dir.
find_plugins_source() {
  local target_name="$1"
  local best="" best_count=0 dir name count ver

  while IFS= read -r ver; do
    [[ -n "$ver" ]] || continue
    name="$(data_dir_name "$ver" 2>/dev/null || true)"
    [[ -n "$name" && "$name" != "$target_name" ]] || continue
    dir="$(plugins_root "$name")"
    count="$(plugin_entry_count "$dir")"
    if [[ "$count" -gt "$best_count" ]]; then
      best="$dir"
      best_count="$count"
    fi
  done < <(installed_versions | sort -Vr)

  if [[ "$best_count" -eq 0 ]]; then
    for dir in "$HOME"/.local/share/JetBrains/PyCharm*; do
      [[ -d "$dir" ]] || continue
      name="$(basename "$dir")"
      [[ "$name" != "$target_name" ]] || continue
      count="$(plugin_entry_count "$dir")"
      if [[ "$count" -gt "$best_count" ]]; then
        best="$dir"
        best_count="$count"
      fi
    done
  fi

  [[ "$best_count" -gt 0 ]] && printf '%s\n' "$best"
}

# Copy user-installed plugins into the active version's share dir.
# Uses rsync --ignore-existing so a partial/new dir fills in without clobbering.
migrate_user_plugins() {
  local version="$1"
  local target_name target source before after
  target_name="$(data_dir_name "$version" 2>/dev/null || true)"
  [[ -n "$target_name" ]] || {
    log "plugins: skip (no dataDirectoryName for $version)"
    return 0
  }
  target="$(plugins_root "$target_name")"
  source="$(find_plugins_source "$target_name" || true)"
  if [[ -z "$source" ]]; then
    log "plugins: nothing to migrate into $target_name"
    return 0
  fi

  require_cmd rsync
  before="$(plugin_entry_count "$target")"
  mkdir -p "$target"
  log "plugins: migrating $(basename "$source") -> $target_name"
  rsync -a --ignore-existing "$source/" "$target/"
  after="$(plugin_entry_count "$target")"
  log "plugins: $before -> $after entries in $target"
}

config_root() {
  printf '%s/.config/JetBrains/%s\n' "$HOME" "$1"
}

# Prior config dir that has the richest recentProjects.xml (bytes), else any other PyCharm* config.
find_config_source() {
  local target_name="$1"
  local best="" best_size=0 dir name size ver recent

  while IFS= read -r ver; do
    [[ -n "$ver" ]] || continue
    name="$(data_dir_name "$ver" 2>/dev/null || true)"
    [[ -n "$name" && "$name" != "$target_name" ]] || continue
    dir="$(config_root "$name")"
    recent="$dir/options/recentProjects.xml"
    [[ -f "$recent" ]] || continue
    size="$(wc -c <"$recent" | tr -d ' ')"
    if [[ "$size" -gt "$best_size" ]]; then
      best="$dir"
      best_size="$size"
    fi
  done < <(installed_versions | sort -Vr)

  if [[ "$best_size" -eq 0 ]]; then
    for dir in "$HOME"/.config/JetBrains/PyCharm*; do
      [[ -d "$dir" ]] || continue
      name="$(basename "$dir")"
      [[ "$name" != "$target_name" ]] || continue
      recent="$dir/options/recentProjects.xml"
      [[ -f "$recent" ]] || continue
      size="$(wc -c <"$recent" | tr -d ' ')"
      if [[ "$size" -gt "$best_size" ]]; then
        best="$dir"
        best_size="$size"
      fi
    done
  fi

  [[ "$best_size" -gt 0 ]] && printf '%s\n' "$best"
}

# Copy config file if missing; for recentProjects-like maps, replace when source
# has more <entry key=...> rows (a fresh IDE stub must not block a full history).
copy_config_prefer_richer() {
  local src="$1" dest="$2"
  local src_n=0 dest_n=0
  [[ -f "$src" ]] || return 0
  mkdir -p "$(dirname "$dest")"
  if [[ ! -f "$dest" ]]; then
    cp -a "$src" "$dest"
    log "config: copied $(basename "$dest")"
    return 0
  fi
  src_n="$(grep -c 'entry key=' "$src" 2>/dev/null || true)"
  dest_n="$(grep -c 'entry key=' "$dest" 2>/dev/null || true)"
  # Non-map files (no entry keys): only fill if dest missing (handled above).
  if [[ "$src_n" -eq 0 && "$dest_n" -eq 0 ]]; then
    log "config: keep existing $(basename "$dest")"
    return 0
  fi
  if [[ "$src_n" -gt "$dest_n" ]]; then
    cp -a "$src" "$dest"
    log "config: replaced $(basename "$dest") ($dest_n -> $src_n entries)"
  else
    log "config: keep existing $(basename "$dest") ($dest_n entries)"
  fi
}

# Recent projects list + trust + matching workspace snapshots for the welcome screen.
migrate_recent_projects() {
  local version="$1"
  local target_name target source
  target_name="$(data_dir_name "$version" 2>/dev/null || true)"
  [[ -n "$target_name" ]] || {
    log "recent-projects: skip (no dataDirectoryName for $version)"
    return 0
  }
  target="$(config_root "$target_name")"
  source="$(find_config_source "$target_name" || true)"
  if [[ -z "$source" ]]; then
    log "recent-projects: nothing to migrate into $target_name"
    return 0
  fi

  log "recent-projects: migrating $(basename "$source") -> $target_name"
  mkdir -p "$target/options" "$target/workspace"
  copy_config_prefer_richer "$source/options/recentProjects.xml" "$target/options/recentProjects.xml"
  copy_config_prefer_richer "$source/options/trusted-paths.xml" "$target/options/trusted-paths.xml"
  # Defaults: only seed if absent (no entry-key richness signal).
  if [[ -f "$source/options/project.default.xml" && ! -f "$target/options/project.default.xml" ]]; then
    cp -a "$source/options/project.default.xml" "$target/options/project.default.xml"
    log "config: copied project.default.xml"
  fi

  if [[ -d "$source/workspace" ]]; then
    require_cmd rsync
    rsync -a --ignore-existing "$source/workspace/" "$target/workspace/"
    log "recent-projects: workspace snapshots synced (ignore-existing)"
  fi
}

# Prefer missing dest, else replace when source is strictly larger (fresh stubs are tiny).
copy_file_prefer_larger() {
  local src="$1" dest="$2"
  local src_size=0 dest_size=0
  [[ -f "$src" ]] || return 0
  mkdir -p "$(dirname "$dest")"
  src_size="$(wc -c <"$src" | tr -d ' ')"
  if [[ ! -f "$dest" ]]; then
    cp -a "$src" "$dest"
    log "settings: copied $(basename "$(dirname "$dest")")/$(basename "$dest")"
    return 0
  fi
  dest_size="$(wc -c <"$dest" | tr -d ' ')"
  if [[ "$src_size" -gt "$dest_size" ]]; then
    cp -a "$src" "$dest"
    log "settings: replaced $(basename "$dest") (${dest_size} -> ${src_size} bytes)"
  else
    log "settings: keep existing $(basename "$dest")"
  fi
}

sync_dir_ignore_existing() {
  local src="$1" dest="$2" label="$3"
  [[ -d "$src" ]] || return 0
  require_cmd rsync
  mkdir -p "$dest"
  rsync -a --ignore-existing "$src/" "$dest/"
  log "settings: synced $label (ignore-existing)"
}

# High-value IDE settings (not a full config clone — skips caches, tokens, promo noise).
migrate_ide_settings() {
  local version="$1"
  local target_name target source f
  target_name="$(data_dir_name "$version" 2>/dev/null || true)"
  [[ -n "$target_name" ]] || {
    log "settings: skip (no dataDirectoryName for $version)"
    return 0
  }
  target="$(config_root "$target_name")"
  source="$(find_config_source "$target_name" || true)"
  if [[ -z "$source" ]]; then
    log "settings: nothing to migrate into $target_name"
    return 0
  fi

  log "settings: migrating $(basename "$source") -> $target_name"
  mkdir -p "$target/options"

  # SDKs / runtimes / VCS / DB / editor prefs
  for f in \
    jdk.table.xml \
    pySdk.xml \
    nodejs.xml \
    editor.xml \
    ide.general.xml \
    ide.general.local.xml \
    colors.scheme.xml \
    editor-font.xml \
    console-font.xml \
    terminal-font.xml \
    keymapFlags.xml \
    github.xml \
    gitlab.xml \
    databaseSettings.xml \
    databaseDrivers.xml \
    diff.xml \
    web-browsers.xml \
    proxy.settings.xml \
    remote-servers.xml \
    llm.for.code.xml \
    llm.mcpServers.xml \
    llm.nextEdits.xml
  do
    copy_file_prefer_larger "$source/options/$f" "$target/options/$f"
  done

  # Top-level text/props (not under options/)
  copy_file_prefer_larger "$source/disabled_plugins.txt" "$target/disabled_plugins.txt"
  # idea.properties: only seed if absent so we don't clobber version-specific tweaks.
  if [[ -f "$source/idea.properties" && ! -f "$target/idea.properties" ]]; then
    cp -a "$source/idea.properties" "$target/idea.properties"
    log "settings: copied idea.properties"
  fi

  sync_dir_ignore_existing "$source/keymaps" "$target/keymaps" "keymaps/"
  sync_dir_ignore_existing "$source/codestyles" "$target/codestyles" "codestyles/"
  sync_dir_ignore_existing "$source/inspection" "$target/inspection" "inspection/"
  sync_dir_ignore_existing "$source/extensions" "$target/extensions" "extensions/"
  sync_dir_ignore_existing "$source/grazie" "$target/grazie" "grazie/"
  sync_dir_ignore_existing "$source/tasks" "$target/tasks" "tasks/"
  sync_dir_ignore_existing "$source/ssl" "$target/ssl" "ssl/"
}

releases_all_json() {
  require_cmd curl
  require_cmd jq
  curl -fsSL "https://data.services.jetbrains.com/products/releases?code=${PRODUCT_CODE}&type=release"
}

release_for_version() {
  local version="$1"
  releases_all_json | jq -c --arg code "$PRODUCT_CODE" --arg v "$version" '
    .[$code][] | select(.version == $v)
  ' | head -n1
}

# --- runtime hooks (used by activate; install calls activate by default) ---

apply_vmoptions_fix() {
  local version="${1:-}"
  local config_dirs=() dir opts

  if [[ -n "$version" ]]; then
    mkdir -p "$HOME/.config/JetBrains/PyCharm${version}"
    config_dirs=("$HOME/.config/JetBrains/PyCharm${version}")
  fi
  mapfile -t -O "${#config_dirs[@]}" config_dirs < <(
    find "$HOME/.config/JetBrains" -maxdepth 1 -type d -name 'PyCharm*' 2>/dev/null || true
  )

  # Deduplicate
  local -A seen=()
  local unique=()
  for dir in "${config_dirs[@]:-}"; do
    [[ -n "$dir" ]] || continue
    [[ -n "${seen[$dir]:-}" ]] && continue
    seen[$dir]=1
    unique+=("$dir")
  done

  for dir in "${unique[@]:-}"; do
    opts="$dir/pycharm64.vmoptions"
    # -- required: option string begins with -D
    if [[ -f "$opts" ]] && grep -qxF -- "$VM_OPTION_SHADOW" "$opts"; then
      log "vmoptions ok: $opts"
      continue
    fi
    if [[ ! -f "$opts" ]]; then
      cat >"$opts" <<EOF
# custom PyCharm VM options (expand/override 'bin/pycharm64.vmoptions')

$VM_OPTION_SHADOW
EOF
    else
      printf '\n%s\n' "$VM_OPTION_SHADOW" >>"$opts"
    fi
    log "applied $VM_OPTION_SHADOW -> $opts"
  done
}

ensure_wslu() {
  if command -v wslusc >/dev/null 2>&1 && command -v wslview >/dev/null 2>&1; then
    log "wslu present"
    return 0
  fi
  log "installing wslu (needs sudo)"
  require_cmd sudo
  sudo apt-get update
  if ! apt-cache show wslu >/dev/null 2>&1; then
    sudo add-apt-repository -y ppa:wslutilities/wslu
    sudo apt-get update
  fi
  sudo apt-get install -y wslu
}

update_shell_alias() {
  local alias_target alias_line tmp
  if [[ "$STABLE_LINK" == "$HOME/downloads/pycharm" ]]; then
    alias_target='$HOME/downloads/pycharm/bin/pycharm.sh'
  else
    alias_target="$STABLE_LINK/bin/pycharm.sh"
  fi
  alias_line="alias pycharm='( \"$alias_target\" > /dev/null 2>&1 & )'"

  touch "$ZSHRC"
  if grep -qE '^alias pycharm=' "$ZSHRC"; then
    tmp="$(mktemp)"
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" == alias\ pycharm=* ]]; then
        printf '%s\n' "$alias_line"
      else
        printf '%s\n' "$line"
      fi
    done <"$ZSHRC" >"$tmp"
    mv "$tmp" "$ZSHRC"
    log "updated pycharm alias in $ZSHRC"
  else
    {
      printf '\n# PyCharm: launch via stable symlink managed by pycharm-wsl\n'
      printf '%s\n' "$alias_line"
    } >>"$ZSHRC"
    log "added pycharm alias to $ZSHRC"
  fi

  if ! grep -q 'BROWSER=wslview' "$ZSHRC"; then
    {
      printf '\n# CLI tools that honor $BROWSER open links in Windows (wslu)\n'
      printf 'command -v wslview >/dev/null && export BROWSER=wslview\n'
    } >>"$ZSHRC"
    log "added BROWSER=wslview to $ZSHRC"
  fi
}

# Fixed-path wrapper for Windows shortcuts. wslusc runs readlink -f on the
# command, which would bake pycharm-<version> into the .lnk if we passed the
# stable symlink directly; this file path stays constant across activates.
ensure_launcher_wrapper() {
  local wrapper="$INSTALL_ROOT/pycharm-wsl-run"
  ensure_install_root
  cat >"$wrapper" <<EOF
#!/usr/bin/env bash
# Generated by pycharm-wsl — do not edit; retarget via: pycharm-wsl activate <version>
set -euo pipefail
exec "$STABLE_LINK/bin/pycharm.sh" "\$@"
EOF
  chmod +x "$wrapper"
  printf '%s\n' "$wrapper"
}

create_shortcut() {
  local icon launcher wrapper
  [[ -x "$STABLE_LINK/bin/pycharm.sh" ]] || die "missing launcher under $STABLE_LINK (activate symlink first)"
  wrapper="$(ensure_launcher_wrapper)"
  icon="$STABLE_LINK/bin/pycharm.png"
  ensure_wslu
  # -g = GUI app: uses wscript/helper (or wslg) instead of a console ubuntu.exe window.
  local -a wslusc_args=(-g -n "$SHORTCUT_NAME")
  if [[ -f "$icon" ]]; then
    # wslusc historically needed ImageMagick for PNG → shortcut icon.
    if ! command -v convert >/dev/null 2>&1; then
      log "installing imagemagick for shortcut icon (needs sudo)"
      sudo apt-get update
      sudo apt-get install -y imagemagick
    fi
    wslusc_args+=(-i "$icon")
  fi
  wslusc "${wslusc_args[@]}" "$wrapper"
  log "shortcut: $SHORTCUT_NAME -> $wrapper -> $STABLE_LINK"
}

# Human size for logs (e.g. 1.3G). Falls back to raw bytes.
fmt_bytes() {
  local n="$1"
  if command -v numfmt >/dev/null 2>&1; then
    numfmt --to=iec-i --suffix=B --format='%.1f' "$n" 2>/dev/null && return 0
  fi
  printf '%s bytes\n' "$n"
}

# Download with size / speed / ETA when possible.
# Prefer pv (bytes + ETA) if installed; else curl's classic progress meter
# (% / transferred / time left / speed) — not the minimal --progress-bar.
download_file() {
  local url="$1" dest="$2" label="${3:-download}"
  local size="" curl_stat pv_stat

  size="$(
    curl -fsSI "$url" 2>/dev/null \
      | awk 'tolower($1) == "content-length:" { print $2 }' \
      | tr -d '\r' \
      | tail -n1 || true
  )"

  if [[ -t 2 ]] && command -v pv >/dev/null 2>&1 && [[ "$size" =~ ^[0-9]+$ ]]; then
    log "downloading $label ($(fmt_bytes "$size")) via pv"
    # shellcheck disable=SC2094
    curl -fL "$url" | pv -s "$size" -p -t -e -r -b -N "$label" >"$dest"
    curl_stat=${PIPESTATUS[0]}
    pv_stat=${PIPESTATUS[1]}
    [[ "$curl_stat" -eq 0 && "$pv_stat" -eq 0 ]] || die "download failed ($label): curl=$curl_stat pv=$pv_stat"
    return 0
  fi

  if [[ -t 2 ]]; then
    if [[ "$size" =~ ^[0-9]+$ ]]; then
      log "downloading $label ($(fmt_bytes "$size")) — % / size / ETA / speed"
    else
      log "downloading $label"
    fi
    curl -fL -o "$dest" "$url" || die "download failed: $url"
    return 0
  fi

  log "downloading $label (non-TTY)"
  curl -fsL -o "$dest" "$url" || die "download failed: $url"
}

download_and_extract() {
  local version="$1" link="$2" checksum_url="$3"
  local archive dest tmp extract_root expected actual

  archive="$(version_archive "$version")"
  dest="$(version_dir "$version")"
  ensure_install_root

  if is_installed "$version"; then
    log "already installed: $dest"
    return 0
  fi

  if [[ ! -f "$archive" ]]; then
    download_file "$link" "$archive.partial" "pycharm-${version}"
    mv "$archive.partial" "$archive"
  else
    log "reusing archive: $archive"
  fi

  if [[ -n "$checksum_url" ]]; then
    log "verifying sha256"
    expected="$(curl -fsSL "$checksum_url" | awk '{print $1}')"
    actual="$(sha256sum "$archive" | awk '{print $1}')"
    [[ "$expected" == "$actual" ]] || die "checksum mismatch for $archive"
  fi

  tmp="$(mktemp -d "$INSTALL_ROOT/.pycharm-extract.XXXXXX")"
  log "extracting to $dest"
  tar -xzf "$archive" -C "$tmp"
  extract_root="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -n1)"
  [[ -n "$extract_root" ]] || {
    rm -rf "$tmp"
    die "archive contained no top-level directory"
  }
  rm -rf "$dest"
  mv "$extract_root" "$dest"
  rm -rf "$tmp"
}

# --- commands ---

cmd_list() {
  require_cmd jq
  local active remote_json
  local -A installed_set=()
  local ver markers

  active="$(active_version || true)"
  while IFS= read -r ver; do
    [[ -n "$ver" ]] || continue
    installed_set["$ver"]=1
  done < <(installed_versions)

  remote_json="$(releases_all_json)"
  printf 'product: %s\n' "$PRODUCT_CODE"
  printf 'root:    %s\n' "$INSTALL_ROOT"
  printf 'active:  %s\n' "${active:-'(none)'}"
  printf '\n'

  # Remote releases (newest first from API)
  local count=0
  while IFS= read -r ver; do
    [[ -n "$ver" ]] || continue
    markers=""
    if [[ -n "${installed_set[$ver]:-}" ]]; then
      markers=" (installed)"
      unset "installed_set[$ver]"
    fi
    if [[ -n "$active" && "$ver" == "$active" ]]; then
      markers="${markers} (active)"
    fi
    printf '%s%s\n' "$ver" "$markers"
    count=$((count + 1))
    [[ "$count" -ge "$LIST_LIMIT" ]] && break
  done < <(jq -r --arg code "$PRODUCT_CODE" '.[$code][].version' <<<"$remote_json")

  # Local-only installs not present in the remote window / catalog
  local extras=()
  for ver in "${!installed_set[@]}"; do
    extras+=("$ver")
  done
  if [[ ${#extras[@]} -gt 0 ]]; then
    printf '\n# local only\n'
    local sorted
    sorted="$(printf '%s\n' "${extras[@]}" | sort -V)"
    while IFS= read -r ver; do
      markers=" (installed)"
      if [[ -n "$active" && "$ver" == "$active" ]]; then
        markers="${markers} (active)"
      fi
      printf '%s%s\n' "$ver" "$markers"
    done <<<"$sorted"
  fi
}

cmd_install() {
  local version="" no_activate=0
  local arg json link checksum

  for arg in "$@"; do
    case "$arg" in
      --no-activate) no_activate=1 ;;
      -*) die "unknown option: $arg" ;;
      *)
        [[ -z "$version" ]] || die "unexpected argument: $arg"
        version="$arg"
        ;;
    esac
  done
  [[ -n "$version" ]] || die "usage: install VERSION [--no-activate]"

  json="$(release_for_version "$version")"
  [[ -n "$json" ]] || die "version not in JetBrains catalog: $version (see list)"
  link="$(jq -r '.downloads.linux.link // empty' <<<"$json")"
  checksum="$(jq -r '.downloads.linux.checksumLink // empty' <<<"$json")"
  [[ -n "$link" ]] || die "no linux download for $version"

  log "installing PyCharm $version"
  download_and_extract "$version" "$link" "$checksum"

  if [[ "$no_activate" -eq 1 ]]; then
    log "installed without activating (use: activate $version)"
    return 0
  fi
  cmd_activate "$version"
}

cmd_uninstall() {
  local version="" keep_archive=0
  local arg dir archive active

  for arg in "$@"; do
    case "$arg" in
      --keep-archive) keep_archive=1 ;;
      -*) die "unknown option: $arg" ;;
      *)
        [[ -z "$version" ]] || die "unexpected argument: $arg"
        version="$arg"
        ;;
    esac
  done
  [[ -n "$version" ]] || die "usage: uninstall VERSION [--keep-archive]"

  dir="$(version_dir "$version")"
  archive="$(version_archive "$version")"
  is_installed "$version" || die "not installed: $version ($dir)"

  active="$(active_version || true)"
  if [[ -n "$active" && "$active" == "$version" ]]; then
    rm -f "$STABLE_LINK"
    log "cleared active symlink (was $version)"
  fi

  log "removing $dir"
  rm -rf "$dir"

  if [[ "$keep_archive" -eq 0 && -f "$archive" ]]; then
    log "removing $archive"
    rm -f "$archive"
  elif [[ -f "$archive" ]]; then
    log "keeping archive: $archive"
  fi
}

cmd_activate() {
  local version="${1:-}"
  local dir
  [[ -n "$version" ]] || die "usage: activate VERSION"
  is_installed "$version" || die "not installed: $version (install it first)"
  dir="$(version_dir "$version")"

  ensure_install_root
  ln -sfn "$dir" "$STABLE_LINK"
  log "active: $STABLE_LINK -> $dir"

  migrate_user_plugins "$version"
  migrate_recent_projects "$version"
  migrate_ide_settings "$version"
  apply_vmoptions_fix "$version"
  update_shell_alias

  if grep -q 'microsoft\|WSL' /proc/version 2>/dev/null; then
    if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
      log "warning: DISPLAY/WAYLAND_DISPLAY unset; WSLg may be unavailable"
    else
      log "display: DISPLAY=${DISPLAY:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
    fi
    create_shortcut
  fi

  log "activated $version — open a new shell or: source $ZSHRC"
  log "launch: pycharm"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    list) cmd_list "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    activate) cmd_activate "$@" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command: $cmd (see --help)" ;;
  esac
}

main "$@"
